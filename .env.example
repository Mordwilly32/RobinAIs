# Copia este archivo a .env y pega los valores de tu proyecto.
# Supabase -> Project Settings -> API
#
# .env esta en .gitignore: la clave service_role se salta TODAS las reglas de
# seguridad, no debe subirse a GitHub ni llegar nunca al navegador.
#
# Solo lo necesita `npm run seed`. El sitio usa la clave anon, que va en
# public/js/supabase-config.js.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
